# Copy to .env and fill in. Used by scripts/setup_serve.sh and docker compose.

# Hugging Face token (same one used to download Qwen / upload the adapter)
HF_TOKEN=

# Official base + adapter repo
BASE_MODEL=Qwen/Qwen3.8-27B
ADAPTER_REPO=TitoFM16/jaffirt

# Where the adapter is materialized for vLLM (created by setup_serve.sh)
ADAPTER_DIR=./models/adapter

# Hugging Face cache (Qwen weights). Defaults to $HOME/.cache/huggingface
# HF_CACHE=/root/.cache/huggingface

# vLLM
VLLM_IMAGE=vllm/vllm-openai:qwen38
VLLM_PORT=8000
VLLM_MAX_MODEL_LEN=65536
VLLM_MAX_NUM_SEQS=1
VLLM_GPU_UTIL=0.90
VLLM_TOOL_PARSER=qwen3_xml
VLLM_REASONING_PARSER=qwen3

# Hermes → vLLM (OpenAI /v1)
HERMES_BASE_URL=http://127.0.0.1:8000/v1
HERMES_MODEL=jaffirt
HERMES_API_KEY=local
HERMES_CONTEXT_LENGTH=65536
HERMES_MAX_TOKENS=4096

# Local Firecrawl for Hermes web_extract. `make hermes` installs Docker on a
# supported Linux host, clones this pinned release, builds it, and smoke-tests
# one fetch of the operator-owned demo URL. Set SETUP_FIRECRAWL=0 to opt out.
SETUP_FIRECRAWL=1
FIRECRAWL_VERSION=v2.11.162
FIRECRAWL_DIR=./.services/firecrawl
FIRECRAWL_PORT=3002
FIRECRAWL_API_URL=http://127.0.0.1:3002

# Claude Code → vLLM (Anthropic Messages API; no /v1 suffix)
CLAUDE_BASE_URL=http://127.0.0.1:8000
CLAUDE_MODEL=jaffirt
CLAUDE_API_KEY=local
